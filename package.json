{
  "name": "fcai-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verify": "eslint . && tsc && node scripts/i18n-check.mjs && vitest run && vite build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "i18next": "^26.5.2",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "0.0.83",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.11",
    "vitest": "^5.0.5"
  }
}
