# === Groq (14 keys hardcoded as fallbacks — ENV overrides them) ===
# Get keys: https://console.groq.com/keys
VITE_GROQ_API_KEY_1=gsk_your-key-here
VITE_GROQ_API_KEY_2=gsk_your-key-here

# === OpenRouter ===
# Get key: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here
VITE_OPENROUTER_MODEL=openrouter/auto

# === OpenAI (paid) ===
VITE_OPENAI_API_KEY=sk-proj-your-key-here

# === Google Gemini (FREE) ===
VITE_GEMINI_API_KEY=AIza-your-key-here
